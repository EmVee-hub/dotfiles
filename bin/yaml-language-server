#!/bin/bash
#Run anchore/grype

IMAGE='quay.io/redhat-developer/yaml-language-server:1.24.0'

docker pull "$IMAGE" > /dev/null 2>&1 &
PULL_PID=$!

# Wait for pull only if the image doesn't exist locally yet
if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
    echo "Pulling yamll image..." >&2
    wait $PULL_PID
fi

docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    "$IMAGE" "$@"



